{
  "super-bartie": {
    "type": "stdio",
    "command": "uv",
    "args": [
      "run",
      "--directory",
      "${CLAUDE_PLUGIN_ROOT}/../..",
      "python",
      "server.py"
    ],
    "env": {
      "BARTIE_API_URL": "${BARTIE_API_URL:-http://localhost:8080}",
      "BARTIE_API_TOKEN": "${BARTIE_API_TOKEN:-}"
    }
  }
}
