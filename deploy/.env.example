# Copy to deploy/.env on the VM. Compose reads it automatically.

# Public hostname for the api. Caddy provisions TLS for it. Point an A record
# at the VM first. For a laptop run leave it unset (plain http://localhost:8088).
API_DOMAIN=api.example.com

# Origins allowed to call the api from a browser (the live page).
MINICDC_CORS_ORIGINS=https://babtuna.vercel.app,http://localhost:3000

# Required as a bearer token on mutations (pause/resume). Leave empty to allow
# anyone; the demo page does not need it.
MINICDC_API_TOKEN=

# Per-IP requests per minute on /demo/* and /ask.
MINICDC_DEMO_RATE_LIMIT=30

# Vector destination. provider: hash | openai | voyage | none
#   hash    free, deterministic keyword hashing; the stack works with no keys
#   openai  text-embedding-3-small (1536) or -3-large (3072)
#   voyage  voyage-3-lite (512) / voyage-3 (1024)
# Changing provider or dim means dropping bartie_vectors so it re-embeds.
MINICDC_EMBED_PROVIDER=hash
MINICDC_EMBED_MODEL=text-embedding-3-small
MINICDC_EMBED_DIM=1536
MINICDC_EMBED_API_KEY=

# /ask answers with Claude when a key is set; without one it returns the top
# matching record verbatim.
MINICDC_LLM_MODEL=claude-opus-5-5
MINICDC_LLM_API_KEY=

# How often the "batch" comparison snapshot of the vector table refreshes.
MINICDC_SNAPSHOT_INTERVAL=5m
